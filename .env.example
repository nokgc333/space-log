# Contact form mail. Set all three or none:
#   none set  -> demo mode: the form answers "accepted" and nothing is sent
#   all three -> real sending through Resend (https://resend.com)
#   only some -> the form reports a failure and the server log names what is missing
#
# Copy this file to .env.local (never commit real values).
# On the host (e.g. Vercel) set the same names in the project's environment settings.

# Resend API key.
RESEND_API_KEY=

# Sender. The domain must be verified in Resend (DKIM / SPF).
# Plain address or "Name <address>", e.g. Site <contact@your-domain.example>
CONTACT_MAIL_FROM=

# Where the entries go: one plain address.
CONTACT_MAIL_TO=
